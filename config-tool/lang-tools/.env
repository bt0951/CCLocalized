#配置文件目录的绝对路径
FILE_PATH="C:\cocos_project\CCLocalized\config-tool\填表"
#配置文件生成类型服务器用还是客户端用 值 server 或者 client 不设置此值就是通用不过滤配置
GENERATE_TYPE="client"
#生成配置文件目录的绝对路径
GENERATE_PATH="C:\cocos_project\CCLocalized\assets\resources\config"
#生成json文件对应的ts 目录的绝对路径
GENERATE_TS_PATH="C:\cocos_project\CCLocalized\assets\script\config"
#是否需要格式化JSON 
PRETTY_FORMAT=TRUE
#是否需要用文件名作为ts根目录 (当次为TURE时 index将不会生成)
ROOTOBJECT_FILENAME=TRUE
#生成config interface
GENERATE_ALL_INTERFACE=TRUE
NO_CLEAN_DIR=TRUE